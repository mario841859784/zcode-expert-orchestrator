{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/origin-chain-guard.mjs"],
            "timeoutMs": 15000,
            "statusMessage": "origin-chain 递归防护检查"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/route-telemetry.mjs"],
            "timeoutMs": 15000,
            "statusMessage": "路由遥测落盘"
          }
        ]
      }
    ]
  }
}
